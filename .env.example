DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fireside_chat?schema=public"
# Optional unpooled URL for migrations on hosted Neon environments.
DIRECT_URL=""

# The public preview's web process runs free publisher recovery after startup.
# No paid Render cron is required; a GitHub Actions wake-up keeps the worker running.
TRANSCRIPT_RECOVERY_AUTOSTART=true
FEED_REFRESH_AUTOMATIC=true
PUBLISHER_BACKFILL_PER_RUN=80
TRANSCRIPT_DISCOVERY_PER_RUN=15
EXTERNAL_TRANSCRIPT_MAX_ATTEMPTS=3
STARTUP_ARCHIVE_SYNC=false

FEED_FETCH_TIMEOUT_MS=20000
FEED_MAX_BYTES=10485760
FEED_USER_AGENT="FiresideChat/0.1 (+https://github.com/neophilism/FiresideChat)"

# Free publisher / episode website transcripts always run first.
# The external OpenAI speech-to-text provider incurs usage fees, so this
# fallback will not run until both its key and explicit opt-in are configured.
TRANSCRIPTION_ENABLED=false
OPENAI_API_KEY=""
TRANSCRIPTION_MODEL="whisper-1"
TRANSCRIPTION_MAX_EPISODES_PER_RUN=2
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_RETRY_DELAY_MINUTES=60
# Maximum bytes for SOURCE audio; ffmpeg splits files into 15 minute chunks.
TRANSCRIPTION_MAX_AUDIO_BYTES=367001600
TRANSCRIPTION_MAX_DURATION_SECONDS=14400
TRANSCRIPTION_TIMEOUT_MS=120000
# Bounds on attempted audio duration across the entire production archive.
TRANSCRIPTION_DAILY_MAX_MINUTES=180
TRANSCRIPTION_MONTHLY_MAX_MINUTES=1800
# FFMPEG_PATH=/usr/bin/ffmpeg

ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
ADMIN_STALE_FEED_HOURS=36
