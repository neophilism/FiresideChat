DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fireside_chat?schema=public"
# Optional direct/unpooled Postgres URL used for schema migrations in hosted environments.
# If omitted, startup migrations fall back to DATABASE_URL.
DIRECT_URL=""

# Optional RSS ingestion limits.
FEED_FETCH_TIMEOUT_MS=20000
FEED_MAX_BYTES=10485760
FEED_USER_AGENT="FiresideChat/0.1 (+https://github.com/neophilism/FiresideChat)"

# Optional generated-transcript fallback. Disabled by default to prevent accidental API spend.
TRANSCRIPTION_ENABLED=false
OPENAI_API_KEY=""
# Segment timestamps currently use whisper-1.
TRANSCRIPTION_MODEL="whisper-1"
TRANSCRIPTION_MAX_EPISODES_PER_RUN=2
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_RETRY_DELAY_MINUTES=60
TRANSCRIPTION_MAX_AUDIO_BYTES=25165824
TRANSCRIPTION_TIMEOUT_MS=120000

# Private operations dashboard. Both values are required before /admin can be used.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
ADMIN_STALE_FEED_HOURS=36

