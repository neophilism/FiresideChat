generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PersonKind {
  HOUSE
  SENATE
  SHADOW_SENATE
  PRESIDENT
}

enum PodcastRole {
  HOST
  COHOST
  OFFICIAL_PRODUCER
}

enum TranscriptStatus {
  MISSING
  AVAILABLE
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum TranscriptSource {
  PUBLISHER
  GENERATED
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum PublishingStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

model Person {
  id           String          @id @default(cuid())
  slug         String          @unique
  fullName     String
  kind         PersonKind
  state        String?
  party        String?
  serviceStart DateTime?
  serviceEnd   DateTime?
  isCurrent    Boolean         @default(false)
  portraitUrl  String?
  shortBio     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  podcasts     PodcastPerson[]

  @@index([isCurrent])
  @@index([kind])
}

model Podcast {
  id                    String           @id @default(cuid())
  slug                  String           @unique
  title                 String
  rssUrl                String           @unique
  websiteUrl            String?
  description           String?
  active                Boolean          @default(true)
  publishingStatus      PublishingStatus @default(UNKNOWN)
  verificationUrl       String?
  verifiedAt            DateTime?
  verificationNote      String?
  feedTitle             String?
  feedDescription       String?
  feedWebsiteUrl        String?
  feedImageUrl          String?
  language              String?
  feedEtag              String?
  feedLastModified      String?
  resolvedFeedUrl       String?
  lastCheckedAt         DateTime?
  lastSuccessfulCheckAt DateTime?
  lastEpisodeAt         DateTime?
  consecutiveFailures   Int              @default(0)
  nextRetryAt           DateTime?
  lastError             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  feedScopes            FeedScopeRecord[]
  people                PodcastPerson[]
  episodes              Episode[]
  ingestionRuns         IngestionRun[]

  @@index([active])
  @@index([lastEpisodeAt])
  @@index([nextRetryAt])
}

model PodcastPerson {
  podcastId String
  personId  String
  role      PodcastRole
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([podcastId, personId, role])
  @@index([personId])
}

model Episode {
  id               String           @id @default(cuid())
  podcastId        String
  sourceFeedUrl    String?
  guid             String
  title            String
  description      String?
  publishedAt      DateTime
  sourceUpdatedAt  DateTime?
  durationSeconds  Int?
  audioUrl         String
  audioMimeType    String?
  episodeUrl       String?
  imageUrl         String?
  publisherTranscriptUrl      String?
  publisherTranscriptMimeType String?
  transcriptStatus          TranscriptStatus @default(MISSING)
  transcriptionAttempts     Int              @default(0)
  publisherTranscriptAttempts       Int       @default(0)
  publisherTranscriptLastAttemptAt  DateTime?
  publisherTranscriptLastError      String?
  transcriptDiscoveryAttempts       Int       @default(0)
  transcriptDiscoveryLastAttemptAt  DateTime?
  transcriptDiscoveryLastError      String?
  transcriptionLastAttemptAt DateTime?
  transcriptionLastError    String?
  createdAt                 DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  podcast          Podcast          @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  transcript       Transcript?

  @@unique([podcastId, guid])
  @@index([publishedAt])
  @@index([podcastId, publishedAt])
  @@index([podcastId, sourceFeedUrl])
  @@index([transcriptStatus])
}

model Transcript {
  id        String              @id @default(cuid())
  episodeId String              @unique
  source    TranscriptSource
  language  String              @default("en")
  fullText  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  episode   Episode             @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  segments  TranscriptSegment[]
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  startSeconds Float
  endSeconds   Float
  text         String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, startSeconds])
}

model IngestionRun {
  id              String             @id @default(cuid())
  podcastId       String
  status          IngestionRunStatus @default(RUNNING)
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
  httpStatus      Int?
  notModified     Boolean            @default(false)
  feedBytes       Int?
  episodesSeen    Int                @default(0)
  episodesCreated Int                @default(0)
  episodesUpdated Int                @default(0)
  episodesSkipped Int                @default(0)
  error           String?
  podcast         Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId, startedAt])
  @@index([status])
}


enum InquiryEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model PodcastProductionInquiry {
  id                 String             @id @default(cuid())
  memberName         String
  chamber            String
  state              String
  district           String?
  officeKey          String
  contactEmailHash   String
  clientHash         String
  protectedDetails   String
  emailStatus        InquiryEmailStatus @default(PENDING)
  emailSentAt        DateTime?
  emailAttempts      Int                @default(0)
  emailLastAttemptAt DateTime?
  emailLastError     String?
  submittedAt        DateTime           @default(now())
  reviewedAt         DateTime?

  @@index([officeKey, submittedAt])
  @@index([clientHash, submittedAt])
  @@index([contactEmailHash, submittedAt])
  @@index([emailStatus, emailLastAttemptAt])
}

enum FeedScopeMode {
  DEDICATED
  SHARED
}
enum FeedScopeReview {
  PENDING
  APPROVED
  REJECTED
}
enum FeedScopeEvent {
  SUBMITTED
  EPISODE_EVIDENCE_ADDED
  HOST_EVIDENCE_ADDED
  APPROVED
  REJECTED
}
model FeedScopeRecord {
  id               String            @id @default(cuid())
  podcastId        String
  feedUrl          String
  publishedTitle   String
  publishedWebsite String?
  mode             FeedScopeMode
  status           FeedScopeReview   @default(PENDING)
  reviewSourceUrl  String?
  reviewNote       String?
  reviewerRef      String?
  reviewedOn       DateTime?         @db.Date
  revision         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  podcast          Podcast          @relation(fields: [podcastId], references: [id], onDelete: Restrict)
  hosts            FeedScopeHost[]
  episodes         FeedScopeEpisode[]
  audit            FeedScopeAudit[]

  @@unique([podcastId, feedUrl])
  @@index([status, createdAt])
}
model FeedScopeHost {
  id           String          @id @default(cuid())
  scopeId      String
  personId     String
  role         PodcastRole
  fromOn       DateTime        @db.Date
  toOn         DateTime?       @db.Date
  sourceUrl    String
  observedOn   DateTime        @db.Date
  scope        FeedScopeRecord @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@unique([scopeId, personId, role, fromOn])
  @@index([scopeId, personId])
}
model FeedScopeEpisode {
  id           String          @id @default(cuid())
  scopeId      String
  guid         String
  sourceUrl    String
  observedOn   DateTime        @db.Date
  scope        FeedScopeRecord @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@unique([scopeId, guid])
}
model FeedScopeAudit {
  id           String          @id @default(cuid())
  scopeId      String
  revision     Int
  actorRef     String
  event        FeedScopeEvent
  note         String
  createdAt    DateTime        @default(now())
  scope        FeedScopeRecord @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@unique([scopeId, revision])
}
