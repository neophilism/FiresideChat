{
  "name": "fireside-chat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "prestart": "DATABASE_URL=\"${DIRECT_URL:-$DATABASE_URL}\" npm run db:deploy && DATABASE_URL=\"${DIRECT_URL:-$DATABASE_URL}\" npm run db:seed",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/feeds/*.test.ts src/lib/transcription/*.test.ts src/lib/admin-auth.test.ts src/lib/portraits.test.ts src/data/person-profiles.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "ingest:feeds": "tsx scripts/ingest-feeds.ts",
    "postinstall": "prisma generate",
    "predb:seed": "npm run prisma:generate",
    "preingest:feeds": "npm run prisma:generate",
    "dev:db": "docker compose up -d postgres",
    "dev:setup": "npm run dev:db && npm run db:wait && npm run db:deploy && npm run db:seed && npm run registry:validate",
    "smoke:mvp": "node scripts/smoke-mvp.mjs",
    "db:wait": "node scripts/wait-for-db.mjs",
    "transcribe:missing": "tsx scripts/transcribe-missing.ts",
    "pretranscribe:missing": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.2",
    "fast-xml-parser": "5.11.2",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
